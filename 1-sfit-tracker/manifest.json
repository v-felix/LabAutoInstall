{
  "manifest_version": 3,
  "name": "SFIT Tracker",
  "version": "2.0.0",
  "minimum_chrome_version": "120",
  "description": "Scheduled exam controls. Edit config.js before packaging.",
  "permissions": [
    "tabs",
    "webNavigation",
    "storage",
    "alarms",
    "declarativeNetRequest",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "SFIT Tracker — Lịch thi",
    "default_popup": "status.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "block.html",
        "block.js",
        "ui.css",
        "logo.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "logo.png",
    "32": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "key": ""
}
